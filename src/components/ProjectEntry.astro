---
// One project under Selected work. Reads a `projects` collection entry.
import type { CollectionEntry } from 'astro:content';
import Pull from './Pull.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const p = project.data;
const page = p.caseStudy ? `/work/${project.id}/` : null;
const isExternal = (href: string) => /^https?:/.test(href);
---

<article class:list={['entry', { 'entry--compact': !p.summary }]} id={`p-${project.id}`}>
  <p class="entry__margin"><span>{p.when}</span>{p.context}</p>
  <div class="entry__main">
    <h3 class="entry__title">{page ? <a href={page}>{p.title}</a> : p.title}</h3>
    <p class="entry__dek" set:html={p.dek} />
    {p.summary && <p class="entry__body" set:html={p.summary} />}
    {p.stack.length > 0 && <p class="entry__meta">{p.stack.join(', ')}</p>}
    <p class="links">
      {page && <a href={page}>Read the case study</a>}
      {p.links.map((l) => <a href={l.href} class:list={{ ext: isExternal(l.href) }}>{l.label}</a>)}
      {p.note && <span>{p.note}</span>}
    </p>
  </div>
  <aside class="entry__aside">
    {p.figure ? <Pull value={p.figure.value} caption={p.figure.caption} /> : p.quote && <Pull value={p.quote.text} caption={p.quote.caption} quote />}
  </aside>
</article>
