---
// The four photos on the inside cover. Behavior lives in src/notebook/js/pile.js.
import { getImage } from 'astro:assets';
import { siGithub } from 'simple-icons';
import { site } from '../../data/site';
import desk from '../../assets/photos/desk.jpg';
import lake from '../../assets/photos/lake.jpg';
import lavender from '../../assets/photos/lavender.jpg';
import oldProfile from '../../assets/photos/old-profile.jpg';

const photos = [
  {
    k: 'desk', cls: 'polaroid', src: desk, w: 639, h: 720, pos: '--x:-0.5%;--y:12%;--r:-9deg',
    alt: 'Tommy at his desk, smiling and holding up a peace sign',
    cap: 'at the desk', back: 'Desk, laptop, the stairs behind. Most of this notebook happened here.',
    tape: 'left:34%;top:-10px;transform:rotate(-4deg)',
  },
  {
    k: 'lavender', cls: 'print-l', src: lavender, w: 720, h: 540, pos: '--x:27%;--y:47%;--r:-4deg',
    alt: 'Selfie of Tommy in a trench coat, hair in the wind, in a lavender field with mountains',
    cap: 'lavender, very windy', back: 'Lavender field, mountains, a lot of wind.',
  },
  {
    k: 'lake', cls: 'print-p', src: lake, w: 540, h: 720, pos: '--x:39%;--y:-1%;--r:3deg',
    alt: 'Tommy standing at a wide, calm lake, mountains and a big blue sky behind him',
    cap: 'still water', back: 'A huge, very calm lake. Mostly sky.',
    tape: 'right:-18px;top:14px;transform:rotate(58deg);width:60px',
  },
  {
    k: 'old-profile', cls: 'passport', src: oldProfile, w: 549, h: 720, pos: '--x:1%;--y:67%;--r:6deg',
    alt: 'Headshot of Tommy in glasses and a white polo against a plain wall',
    back: 'The old headshot. Kept for the record.', clip: true,
  },
];
const imgs = await Promise.all(photos.map((p) => getImage({ src: p.src, width: p.w, height: p.h, format: 'webp', quality: 78 })));
---

<div class="pile" id="pile" aria-label="Four photos, piled up">
  <ul class="pile-list">
    {
      photos.map((p, i) => (
        <li class={`photo ${p.cls}`} data-k={p.k} style={p.pos}>
          <button type="button" class="ph" aria-describedby="pile-help">
            <span class="ph-flip">
              <span class="ph-front">
                <img src={imgs[i].src} alt={p.alt} width={p.w} height={p.h} loading="eager" decoding="async" />
                {p.cap && <span class="cap hand">{p.cap}</span>}
              </span>
              <span class="ph-back"><span class="hand">{p.back}</span></span>
            </span>
          </button>
          {p.tape && <span class="tape" style={p.tape} />}
          {p.clip && <span class="clip" aria-hidden="true" />}
        </li>
      ))
    }
  </ul>
  <p class="pile-note hand" id="pile-help">
    a few recent photos of me<span class="sr-only">. You can drag them and flip them over. With the keyboard: Enter flips, arrow keys move.</span>
  </p>
  <div class="pile-links">
    <a class="link-sticker ls-in" href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" /></svg>
      <span class="hand">linkedin</span>
    </a>
    <a class="link-sticker ls-gh" href={site.github} target="_blank" rel="noopener" aria-label="GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={siGithub.path} /></svg>
      <span class="hand">github</span>
    </a>
  </div>
</div>
