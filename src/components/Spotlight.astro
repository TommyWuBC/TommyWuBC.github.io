---
// TEMPORARY: highlights the GT Movies Store project above the regular
// Projects grid. To revert, remove the <Spotlight /> line from
// src/pages/index.astro, delete this file, and remove the
// 'gt-movies-store' exclusion filter in src/components/Projects.astro.
import { projects } from '../data/profile';
import { resolveVideoEmbed } from '../utils/video';

const spotlight = projects.find((p) => p.slug === 'gt-movies-store');
const videoEmbed = spotlight?.video?.url ? resolveVideoEmbed(spotlight.video.url) : null;
---

{
  spotlight && (
    <section id="spotlight" class="section spotlight-section">
      <div class="container spotlight-inner">
        <span class="spotlight-badge">Featured Project</span>
        <h2 class="section-heading">{spotlight.title}</h2>
        <p class="spotlight-summary">{spotlight.summary}</p>

        {videoEmbed && (
          <div class="spotlight-video">
            {videoEmbed.kind === 'file' ? (
              <video class="video-file" controls preload="metadata" src={videoEmbed.src}>
                Your browser doesn't support embedded video.
                <a href={videoEmbed.src}>Download the video</a> instead.
              </video>
            ) : (
              <div class="video-frame">
                <iframe
                  src={videoEmbed.src}
                  title={`${spotlight.title} demo video`}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                />
              </div>
            )}
          </div>
        )}

        <ul class="spotlight-highlights">
          <li>All 21 required user stories mapped to the screen/feature that implements them</li>
          <li>Process and methodology write-up</li>
        </ul>

        {(spotlight.org || spotlight.dates) && (
          <p class="spotlight-meta">
            {spotlight.org}
            {spotlight.org && spotlight.dates ? ' · ' : ''}
            {spotlight.dates}
          </p>
        )}

        <div class="spotlight-actions">
          <a class="btn btn-primary" href={`/projects/${spotlight.slug}/`}>
            View full write-up
          </a>
          {spotlight.links.map((link) => (
            <a class="btn btn-secondary" href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .spotlight-section {
    background: var(--color-accent);
    color: #fff;
    padding-block: var(--space-5);
    border-block: 1px solid var(--color-accent-hover);
  }

  .spotlight-inner {
    max-width: 44rem;
  }

  .spotlight-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    padding: 0.35em 0.8em;
    border-radius: 999px;
    margin-bottom: var(--space-2);
  }

  .spotlight-section .section-heading {
    color: #fff;
    margin-bottom: var(--space-2);
  }

  .spotlight-summary {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--space-3);
  }

  .spotlight-video {
    margin-bottom: var(--space-3);
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(0, 0, 0, 0.2);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-file {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: #000;
  }

  .spotlight-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: var(--space-3);
  }

  .spotlight-highlights li {
    padding-left: 1.4rem;
    position: relative;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
  }

  .spotlight-highlights li::before {
    content: '✓';
    position: absolute;
    left: 0;
    font-weight: 700;
  }

  .spotlight-meta {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
  }

  .spotlight-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .spotlight-actions .btn-primary {
    background: #fff;
    color: var(--color-accent);
  }

  .spotlight-actions .btn-primary:hover {
    background: rgba(255, 255, 255, 0.9);
  }

  .spotlight-actions .btn-secondary {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }

  .spotlight-actions .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #fff;
  }
</style>
