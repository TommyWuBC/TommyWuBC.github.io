---
// TEMPORARY: highlights the GT Movies Store project above the regular
// Projects grid so course TAs/graders see it immediately. To revert, remove
// the <Spotlight /> line from src/pages/index.astro, delete this file, and
// remove the 'gt-movies-store' exclusion filter in src/components/Projects.astro.
import { projects } from '../data/profile';

const spotlight = projects.find((p) => p.slug === 'gt-movies-store');
---

{
  spotlight && (
    <section id="spotlight" class="section spotlight-section">
      <div class="container spotlight-inner">
        <span class="spotlight-badge">Course Project Spotlight, for CS 2340 TAs</span>
        <h2 class="section-heading">{spotlight.title}</h2>
        <p class="spotlight-summary">{spotlight.summary}</p>

        <ul class="spotlight-highlights">
          <li>All 21 required user stories mapped to the screen/feature that implements them</li>
          <li>Process and methodology write-up</li>
          <li>In-browser demo video</li>
        </ul>

        {(spotlight.org || spotlight.dates) && (
          <p class="spotlight-meta">
            {spotlight.org}
            {spotlight.org && spotlight.dates ? ' · ' : ''}
            {spotlight.dates}
          </p>
        )}

        <div class="spotlight-actions">
          <a class="btn btn-primary" href={`/projects/${spotlight.slug}/`}>
            View full write-up and demo video
          </a>
          {spotlight.links.map((link) => (
            <a class="btn btn-secondary" href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .spotlight-section {
    background: var(--color-accent);
    color: #fff;
    padding-block: var(--space-5);
    border-block: 1px solid var(--color-accent-hover);
  }

  .spotlight-inner {
    max-width: 44rem;
  }

  .spotlight-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    padding: 0.35em 0.8em;
    border-radius: 999px;
    margin-bottom: var(--space-2);
  }

  .spotlight-section .section-heading {
    color: #fff;
    margin-bottom: var(--space-2);
  }

  .spotlight-summary {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--space-3);
  }

  .spotlight-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: var(--space-3);
  }

  .spotlight-highlights li {
    padding-left: 1.4rem;
    position: relative;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
  }

  .spotlight-highlights li::before {
    content: '✓';
    position: absolute;
    left: 0;
    font-weight: 700;
  }

  .spotlight-meta {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
  }

  .spotlight-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .spotlight-actions .btn-primary {
    background: #fff;
    color: var(--color-accent);
  }

  .spotlight-actions .btn-primary:hover {
    background: rgba(255, 255, 255, 0.9);
  }

  .spotlight-actions .btn-secondary {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }

  .spotlight-actions .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: #fff;
  }
</style>
