---
import { site } from '../data/profile';
---

<section id="home" class="hero">
  <div class="container hero-inner">
    <img class="hero-photo" src={site.photo} alt={site.name} width="160" height="160" />

    <div class="hero-text">
      <p class="section-eyebrow">Hello, I'm</p>
      <h1>{site.name}</h1>
      <p class="hero-headline">{site.headline} · {site.location}</p>
      <p class="hero-intro">{site.intro}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href={site.github} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
        <a class="btn btn-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >
        <a class="btn btn-secondary" href={site.resumeUrl} target="_blank" rel="noopener noreferrer"
          >Resume</a
        >
        <a class="btn btn-secondary" href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-6);
  }

  .hero-inner {
    max-width: 44rem;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .hero-photo {
    flex-shrink: 0;
    width: 10rem;
    height: 10rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 3px solid var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .hero-text {
    min-width: 0;
  }

  @media (max-width: 40rem) {
    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .hero-photo {
      width: 7.5rem;
      height: 7.5rem;
    }
  }

  .hero h1 {
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3.25rem);
    letter-spacing: -0.02em;
    margin-block: var(--space-1) var(--space-2);
  }

  .hero-headline {
    font-size: 1.15rem;
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .hero-intro {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
