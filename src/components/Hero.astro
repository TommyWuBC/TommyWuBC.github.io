---
import { site } from '../data/profile';
---

<section id="home" class="hero">
  <div class="hero-banner" aria-hidden="true">
    <div class="hero-banner-bg" style={`background-image: url(${site.bannerImage})`} />
    <img class="hero-banner-fg" src={site.bannerImage} alt="" />
    <div class="hero-banner-vignette" />
  </div>

  <div class="container hero-inner">
    <img class="hero-photo" src={site.photo} alt={site.name} width="160" height="160" />

    <div class="hero-text">
      <div class="hero-text-card">
        <p class="section-eyebrow">Hello, I'm</p>
        <h1>{site.name}</h1>
        <p class="hero-headline">{site.headline} · {site.location}</p>
      </div>

      <p class="hero-intro">{site.intro}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href={site.github} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
        <a class="btn btn-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >
        <a class="btn btn-secondary" href={site.resumeUrl} target="_blank" rel="noopener noreferrer"
          >Resume</a
        >
        <a class="btn btn-secondary" href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: 0 var(--space-6);
  }

  .hero-banner {
    position: relative;
    width: 100%;
    height: clamp(10rem, 20vw, 15rem);
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  /* Soft, oversized blurred copy fills the full width on wide screens so
     there's no hard edge or empty gutter beside the crisp centered photo. */
  .hero-banner-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 35%;
    filter: blur(26px) saturate(115%) brightness(0.92);
    transform: scale(1.15);
  }

  /* The real photo, shown at its natural aspect ratio (never stretched or
     cropped tight) and centered over the blurred fill. */
  .hero-banner-fg {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .hero-banner-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      var(--color-bg) 0%,
      transparent 20%,
      transparent 80%,
      var(--color-bg) 100%
    );
    opacity: 0.45;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 44rem;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-top: -4.5rem;
  }

  .hero-photo {
    flex-shrink: 0;
    margin-top: 0.5rem;
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 4px solid var(--color-surface);
    box-shadow: var(--shadow-md);
    background: var(--color-surface);
  }

  .hero-text {
    min-width: 0;
  }

  .hero-text-card {
    display: inline-block;
    background: rgba(255, 255, 255, 0.74);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    border-radius: var(--radius-md);
    padding: 0.7rem 1.1rem;
    box-shadow: 0 2px 14px rgba(30, 25, 15, 0.06);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .hero-text-card {
      background: rgba(255, 255, 255, 0.92);
    }
  }

  .hero-intro {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 40rem) {
    .hero-banner {
      height: clamp(8rem, 34vw, 11rem);
    }

    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      margin-top: -3.5rem;
    }

    .hero-photo {
      width: 8.25rem;
      height: 8.25rem;
    }

    .hero-text-card {
      margin-top: 0.4rem;
    }
  }

  .hero h1 {
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3.25rem);
    letter-spacing: -0.02em;
    margin-block: var(--space-1) var(--space-2);
  }

  .hero-headline {
    font-size: 1.15rem;
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
