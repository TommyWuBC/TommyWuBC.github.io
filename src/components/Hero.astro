---
import { site } from '../data/profile';
---

<section id="home" class="hero">
  <img class="hero-banner" src={site.bannerImage} alt="" aria-hidden="true" />

  <div class="container hero-inner">
    <img class="hero-photo" src={site.photo} alt={site.name} width="160" height="160" />

    <div class="hero-text">
      <div class="hero-text-card">
        <p class="section-eyebrow">Hello, I'm</p>
        <h1>{site.name}</h1>
        <p class="hero-headline">{site.headline} · {site.location}</p>
      </div>

      <p class="hero-intro">{site.intro}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href={site.github} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
        <a class="btn btn-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >
        <a class="btn btn-secondary" href={site.resumeUrl} target="_blank" rel="noopener noreferrer"
          >Resume</a
        >
        <a class="btn btn-secondary" href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: 0 var(--space-6);
  }

  .hero-banner {
    display: block;
    width: 100%;
    height: clamp(9.5rem, 20vw, 14rem);
    object-fit: cover;
    object-position: center 35%;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 44rem;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-top: -4.25rem;
  }

  .hero-photo {
    flex-shrink: 0;
    margin-top: 0.5rem;
    width: 10rem;
    height: 10rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 4px solid var(--color-surface);
    box-shadow: var(--shadow-md);
    background: var(--color-surface);
  }

  .hero-text {
    min-width: 0;
  }

  .hero-text-card {
    display: inline-block;
    background: rgba(255, 255, 255, 0.74);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    border-radius: var(--radius-md);
    padding: 0.7rem 1.1rem;
    box-shadow: 0 2px 14px rgba(30, 25, 15, 0.06);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .hero-text-card {
      background: rgba(255, 255, 255, 0.92);
    }
  }

  .hero-intro {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 40rem) {
    .hero-banner {
      height: clamp(7rem, 32vw, 10rem);
    }

    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      margin-top: -3.25rem;
    }

    .hero-photo {
      width: 7.5rem;
      height: 7.5rem;
    }

    .hero-text-card {
      margin-top: 0.4rem;
    }
  }

  .hero h1 {
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3.25rem);
    letter-spacing: -0.02em;
    margin-block: var(--space-1) var(--space-2);
  }

  .hero-headline {
    font-size: 1.15rem;
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
