---
import { site } from '../data/profile';
---

<section id="home" class="hero">
  <img
    class="hero-banner"
    src={site.bannerImage}
    alt=""
    aria-hidden="true"
    width="1200"
    height="475"
  />

  <div class="container hero-inner">
    <img class="hero-photo" src={site.photo} alt={site.name} width="176" height="176" />

    <div class="hero-text">
      <div class="hero-text-glow">
        <p class="section-eyebrow">Hello, I'm</p>
        <h1>{site.name}</h1>
        <p class="hero-headline">{site.headline} · {site.location}</p>
      </div>

      <p class="hero-intro">{site.intro}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href={site.github} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
        <a class="btn btn-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >
        <a class="btn btn-secondary" href={site.resumeUrl} target="_blank" rel="noopener noreferrer"
          >Resume</a
        >
        <a class="btn btn-secondary" href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: 0 var(--space-6);
  }

  /* Scales by its own intrinsic aspect ratio (no object-fit crop at all)
     so the whole photo is always visible, at any viewport width. The
     width/height attributes above reserve the right aspect ratio before
     the image loads, so this doesn't cause a layout jump. */
  .hero-banner {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 44rem;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-top: -9.5rem;
  }

  .hero-photo {
    flex-shrink: 0;
    margin-top: 0.5rem;
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 4px solid var(--color-surface);
    box-shadow: var(--shadow-md);
    background: var(--color-surface);
  }

  .hero-text {
    min-width: 0;
  }

  /* A soft glow hugging each letter (not a card or a single blob behind
     the block): several stacked, blurred white text-shadows, so every
     glyph gets its own halo that stays legible over any part of the photo. */
  .hero-text-glow .section-eyebrow,
  .hero-text-glow h1,
  .hero-text-glow .hero-headline {
    text-shadow:
      0 0 1px rgba(255, 255, 255, 1),
      0 0 3px rgba(255, 255, 255, 1),
      0 0 5px rgba(255, 255, 255, 1),
      0 0 8px rgba(255, 255, 255, 0.95),
      0 0 12px rgba(255, 255, 255, 0.8);
  }

  .hero-intro {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 40rem) {
    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      margin-top: -4.5rem;
    }

    .hero-photo {
      width: 8.25rem;
      height: 8.25rem;
    }

    .hero-text-glow {
      margin-top: 0.5rem;
    }
  }

  .hero h1 {
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3.25rem);
    letter-spacing: -0.02em;
    margin-block: var(--space-1) var(--space-4);
  }

  .hero-headline {
    font-size: 1.25rem;
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
