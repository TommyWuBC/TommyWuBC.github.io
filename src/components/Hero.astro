---
import { site } from '../data/profile';
---

<section id="home" class="hero">
  <img class="hero-banner" src={site.bannerImage} alt="" aria-hidden="true" />

  <div class="container hero-inner">
    <img class="hero-photo" src={site.photo} alt={site.name} width="176" height="176" />

    <div class="hero-text">
      <div class="hero-text-glow">
        <p class="section-eyebrow">Hello, I'm</p>
        <h1>{site.name}</h1>
        <p class="hero-headline">{site.headline} · {site.location}</p>
      </div>

      <p class="hero-intro">{site.intro}</p>

      <div class="hero-actions">
        <a class="btn btn-primary" href={site.github} target="_blank" rel="noopener noreferrer"
          >GitHub</a
        >
        <a class="btn btn-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer"
          >LinkedIn</a
        >
        <a class="btn btn-secondary" href={site.resumeUrl} target="_blank" rel="noopener noreferrer"
          >Resume</a
        >
        <a class="btn btn-secondary" href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: 0 var(--space-6);
  }

  /* Tall enough on wide screens that a plain cover-crop still reads as
     "the tower and logo", not a tight zoomed-in sliver. */
  .hero-banner {
    display: block;
    width: 100%;
    height: clamp(15rem, 24vw, 22rem);
    object-fit: cover;
    object-position: center 38%;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 44rem;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-top: -7.5rem;
  }

  .hero-photo {
    flex-shrink: 0;
    margin-top: 0.5rem;
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 4px solid var(--color-surface);
    box-shadow: var(--shadow-md);
    background: var(--color-surface);
  }

  .hero-text {
    min-width: 0;
  }

  /* A soft light glow behind the text (not a boxed card): a blurred,
     radial-fading white shape sitting behind the letters, plus a touch of
     text-shadow so glyph edges stay crisp against any part of the photo. */
  .hero-text-glow {
    position: relative;
    isolation: isolate;
  }

  .hero-text-glow::before {
    content: '';
    position: absolute;
    inset: -1.75rem -2.25rem;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(255, 255, 255, 0.75) 40%,
      rgba(255, 255, 255, 0.35) 65%,
      rgba(255, 255, 255, 0) 85%
    );
    filter: blur(10px);
    z-index: -1;
  }

  .hero-text-glow .section-eyebrow,
  .hero-text-glow h1,
  .hero-text-glow .hero-headline {
    text-shadow: 0 1px 3px rgba(255, 255, 255, 0.8), 0 0 18px rgba(255, 255, 255, 0.6);
  }

  .hero-intro {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 40rem) {
    .hero-banner {
      height: clamp(9rem, 40vw, 13rem);
    }

    .hero-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      margin-top: -4.5rem;
    }

    .hero-photo {
      width: 8.25rem;
      height: 8.25rem;
    }

    .hero-text-glow {
      margin-top: 0.5rem;
    }

    .hero-text-glow::before {
      inset: -1.25rem -1.5rem;
    }
  }

  .hero h1 {
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3.25rem);
    letter-spacing: -0.02em;
    margin-block: var(--space-1) var(--space-2);
  }

  .hero-headline {
    font-size: 1.15rem;
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
