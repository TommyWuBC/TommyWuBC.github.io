---
import { Picture } from 'astro:assets';
import desk from '../assets/photos/desk.jpg';
import lavender from '../assets/photos/lavender.jpg';
import Opener from './Opener.astro';
import { about, education, honors, languages, skills, coursework } from '../data/site';

interface Props {
  folio: string;
}
const { folio } = Astro.props;
---

<section class="section about" id="about" data-head="About" data-folio={folio} aria-labelledby="about-h">
  <Opener folio={folio} kicker="Background" id="about-h">About</Opener>
  <div class="grid">
    <div class="about__text">
      {about.map((p) => <p set:html={p} />)}
    </div>
    <div class="about__facts">
      <div>
        <h3>Education</h3>
        <ul>{education.map((e) => <li set:html={e} />)}</ul>
      </div>
      <div>
        <h3>Honors</h3>
        <ul>{honors.map((h) => <li set:html={h} />)}</ul>
      </div>
      <div>
        <h3>Languages</h3>
        <p>{languages}</p>
      </div>
    </div>

    <div class="about__photos">
    <figure class="about__wide">
      <Picture
        src={lavender}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(max-width: 760px) 100vw, 55vw"
        alt="Selfie of Tommy, hair in the wind, in a trench coat in front of a field of purple flowers with forested mountains behind."
      />
      <figcaption>Somewhere with a lot of sky.</figcaption>
    </figure>
    <figure class="about__desk">
      <Picture
        src={desk}
        formats={['avif', 'webp']}
        widths={[400, 700, 1000]}
        sizes="(max-width: 760px) 100vw, 40vw"
        alt="Tommy at a study table with a laptop, smiling and holding up a peace sign; a wooden staircase rises behind him."
      />
      <figcaption>At a desk, which is where most of this happens.</figcaption>
    </figure>
    </div>

    <div class="ref">
      {
        skills.map((s) => (
          <div>
            <h3>{s.label}</h3>
            <p>{s.items}</p>
          </div>
        ))
      }
      <div class="ref__wide">
        <h3>Coursework</h3>
        <p set:html={coursework} />
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-bottom: var(--s9);
  }
  .about__text {
    grid-column: 3 / span 6;
    display: grid;
    gap: var(--s4);
    align-content: start;
    max-width: 60ch;
  }
  .about__text p:first-child {
    font-size: var(--t-lede);
    line-height: 1.42;
  }
  .about__facts {
    grid-column: 10 / -1;
    display: grid;
    gap: var(--s6);
    align-content: start;
  }
  h3 {
    font-family: var(--sans);
    font-size: var(--t-small);
    font-weight: 600;
    padding-bottom: var(--s3);
    margin-bottom: var(--s3);
    border-bottom: 1px solid var(--rule-strong);
  }
  .about__facts li,
  .about__facts p,
  .ref p {
    font-size: 1rem;
    line-height: 1.5;
  }
  .about__facts li + li {
    margin-top: 6px;
  }

  /* the two photographs as a spread, same height */
  .about__photos {
    grid-column: 1 / -1;
    margin-top: var(--s9);
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--gutter);
  }
  .about__photos :global(img) {
    width: 100%;
    height: clamp(300px, 40vw, 600px);
    object-fit: cover;
  }
  .about__wide :global(img) {
    object-position: 30% 50%;
  }
  .about__desk :global(img) {
    object-position: 40% 40%;
  }

  .ref {
    grid-column: 3 / -1;
    margin-top: var(--s8);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--s6);
  }
  .ref__wide {
    grid-column: 1 / span 2;
  }

  @media (max-width: 1080px) {
    .about__text {
      grid-column: 3 / span 7;
    }
    .about__facts {
      grid-column: 3 / -1;
      margin-top: var(--s7);
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .ref {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .about__facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .about__photos {
      margin-top: var(--s7);
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s5);
    }
    .about__photos :global(img) {
      height: auto;
      aspect-ratio: 4 / 3.4;
    }
    .ref {
      grid-template-columns: minmax(0, 1fr);
    }
    .ref__wide {
      grid-column: 1;
    }
  }
</style>
