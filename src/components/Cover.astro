---
// The cover: a two-page spread. The name runs across the gutter and finishes
// in the sky of the lake photograph.
import { Picture } from 'astro:assets';
import lake from '../assets/photos/lake.jpg';
import { site, facts } from '../data/site';

interface Props {
  /** Table of contents: [folio, label, href]. */
  contents: [string, string, string][];
}
const { contents } = Astro.props;
---

<section class="cover" id="top" data-head="Cover" data-folio="1" aria-label="Introduction">
  <div class="cover__page">
    <h1 class="cover__name">{site.name}</h1>
    <p class="cover__dek">{site.dek}</p>
    <p class="cover__links">
      <a href={`mailto:${site.email}`}>Email</a>
      <a href={site.github}>GitHub</a>
      <a href={site.linkedin}>LinkedIn</a>
      <a href={site.resume}>Résumé (PDF)</a>
    </p>
    <div class="cover__foot">
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
        <div><dt>Based in</dt><dd>{site.location}</dd></div>
      </dl>
      <nav class="contents" aria-labelledby="contents-h">
        <h2 id="contents-h">Contents</h2>
        <ol>
          {
            contents.map(([n, label, href]) => (
              <li>
                <a href={href}>
                  <span>{n}</span>
                  <span>{label}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </div>
  <figure class="cover__photo">
    <Picture
      src={lake}
      formats={['avif', 'webp']}
      widths={[480, 760, 1100, 1500]}
      sizes="(max-width: 760px) 100vw, 50vw"
      alt="Tommy standing at the edge of a wide, calm lake under a big blue sky, mountains low on the horizon."
      fetchpriority="high"
      loading="eager"
    />
    <figcaption class="cover__credit">Cover: Tommy, by a lake.</figcaption>
  </figure>
</section>

<style>
  .cover {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: calc(100svh - var(--head-h));
    max-height: 1100px;
  }
  .cover__page {
    grid-column: 1;
    position: relative;
    z-index: 2;
    padding: clamp(40px, 7vh, 88px) var(--s7) var(--s7) var(--margin);
    display: flex;
    flex-direction: column;
  }
  .cover__name {
    font-weight: 300;
    font-size: clamp(5.5rem, 15.2vw, 15rem);
    line-height: 0.82;
    letter-spacing: -0.035em;
    white-space: nowrap;
    margin-left: -0.05em;
    font-variation-settings: 'opsz' 72;
    animation: settle 1.4s 0.15s var(--ease-out) both;
  }
  .cover__dek {
    margin-top: clamp(32px, 5vh, 56px);
    max-width: 31ch;
    font-size: clamp(1.3rem, 1.75vw, 1.625rem);
    line-height: 1.38;
    font-variation-settings: 'opsz' 24;
  }
  .cover__links {
    margin-top: var(--s5);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    font-family: var(--sans);
    font-size: 0.9375rem;
  }
  .cover__links a {
    padding: 4px 0;
  }
  .cover__foot {
    margin-top: auto;
    padding-top: var(--s6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s6);
    font-family: var(--sans);
    font-size: var(--t-small);
    line-height: 1.45;
  }
  .facts {
    display: grid;
    gap: 10px;
    align-content: start;
  }
  .facts div {
    display: grid;
    gap: 1px;
  }
  .facts dt {
    color: var(--ink-2);
  }
  .contents h2 {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
    margin-bottom: 10px;
  }
  .contents ol {
    border-top: 1px solid var(--rule);
  }
  .contents li {
    border-bottom: 1px solid var(--rule);
  }
  .contents a {
    display: grid;
    grid-template-columns: 1.6em 1fr;
    padding: 7px 0;
    text-decoration: none;
  }
  .contents a span:first-child {
    color: var(--ink-2);
    font-variant-numeric: lining-nums;
  }
  .contents a:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cover__photo {
    grid-column: 2;
    position: relative;
  }
  .cover__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
    animation: develop 1.8s cubic-bezier(0.3, 0.6, 0.2, 1) both;
  }
  .cover__credit {
    position: absolute;
    left: -26px;
    bottom: var(--s7);
    z-index: 3;
    margin: 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  @keyframes settle {
    from {
      opacity: 0;
      letter-spacing: 0.02em;
    }
    to {
      opacity: 1;
      letter-spacing: -0.035em;
    }
  }
  @keyframes develop {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 760px) {
    .cover {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      max-height: none;
    }
    .cover__photo {
      grid-column: 1;
      grid-row: 1;
      aspect-ratio: 3 / 3.6;
    }
    .cover__page {
      display: contents;
    }
    .cover__name {
      grid-row: 1;
      grid-column: 1;
      align-self: start;
      z-index: 2;
      padding: 30px var(--margin) 0;
      font-size: clamp(4.5rem, 25vw, 7.5rem);
      white-space: normal;
    }
    .cover__dek {
      grid-row: 2;
      margin: var(--s8) var(--margin) 0;
      font-size: 1.375rem;
    }
    .cover__links {
      grid-row: 3;
      margin: var(--s4) var(--margin) 0;
    }
    .cover__foot {
      grid-row: 4;
      margin: var(--s7) var(--margin) 0;
      grid-template-columns: 1fr;
      gap: var(--s6);
      padding-top: 0;
    }
    .cover__credit {
      writing-mode: horizontal-tb;
      transform: none;
      left: auto;
      right: var(--margin);
      bottom: auto;
      top: calc(100% + 8px);
    }
  }
</style>
