---
// A finding: an italic head and a paragraph, paired with a pull-figure.
// <Finding title="Variety fixes it" value="97.8%" caption="…"> text </Finding>
import Pull from '../Pull.astro';

interface Props {
  title?: string;
  value: string;
  caption: string;
}
const { title, value, caption } = Astro.props;
---

<div class="finding">
  <div class="prose__main">
    {title && <h3>{title}</h3>}
    <slot />
  </div>
  <Pull value={value} caption={caption} class="finding__fig" />
</div>
