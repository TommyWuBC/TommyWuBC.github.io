---
// A full-bleed tinted band for an interactive figure inside a case study.
// <Band folio="Fig. 1" kicker="Interactive" title="Move the gap"> <LavaFigure /> </Band>
import Opener from '../Opener.astro';

interface Props {
  folio: string;
  kicker: string;
  title: string;
}
const { folio, kicker, title } = Astro.props;
const id = `band-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section class="plate-band plate-band--article" data-head={title} data-folio={folio} aria-labelledby={id}>
  <Opener folio={folio} kicker={kicker} id={id}>{title}</Opener>
  <slot />
</section>
