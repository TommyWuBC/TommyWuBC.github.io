---
// A numbered section of a case study: <Section n="§1" title="The question">.
interface Props {
  n: string;
  title: string;
}
const { n, title } = Astro.props;
const id = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<section class="prose__sec" id={id} data-head={title} data-folio={n} aria-labelledby={`${id}-h`}>
  <h2 class="prose__h" id={`${id}-h`}><span class="prose__n">{n}</span><span class="prose__t">{title}</span></h2>
  <slot />
</section>
