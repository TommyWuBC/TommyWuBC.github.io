---
// Wraps a Markdown table with a caption. `numeric` right-aligns every column
// after the first and sets the numbers as lining figures.
interface Props {
  caption: string;
  numeric?: boolean;
}
const { caption, numeric = false } = Astro.props;
---

<figure class:list={['tbl', { 'tbl--num': numeric }]}>
  <figcaption class="tbl__caption" set:html={caption} />
  <div class="tbl__scroll"><slot /></div>
</figure>
