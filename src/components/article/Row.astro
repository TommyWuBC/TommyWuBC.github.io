---
// A text column with an optional sidenote in the margin.
// <Row note="<sup>1</sup> The footnote."> …paragraphs… </Row>
interface Props {
  note?: string;
  wide?: boolean;
}
const { note, wide = false } = Astro.props;
---

<div class="prose__row">
  <div class:list={['prose__main', { 'prose__main--wide': wide }]}><slot /></div>
  {note && <aside class="note"><p set:html={note} /></aside>}
</div>
