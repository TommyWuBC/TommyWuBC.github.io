---
// Webcam gaze, filtered. Simulated noisy gaze (about 30 samples a second) goes
// through a One Euro filter; resting on a product long enough moves focus to it.
// Ported from round-1 entry B's gaze pad and the One Ink gaze figure, restyled in riso.
// Without JS a still frame (drawn below as SVG) stands in.
import { PRODUCTS } from './session-logic';

// a fixed still frame for the static fallback: raw samples scattered around the middle card
const raw = [
  [262, 128], [281, 146], [247, 151], [270, 118], [289, 131], [255, 139], [276, 157], [242, 124],
  [266, 143], [284, 121], [259, 160], [272, 133], [250, 116], [291, 149], [263, 152],
];
---

<figure class="gz" data-gaze data-noturn>
  <div class="gz-pad">
    <canvas class="gz-cv" tabindex="0" role="img"
      aria-label="Gaze pad. Move the pointer over it to steer where the simulated eyes look; arrow keys jump between the three products. Pink dots are raw gaze samples, the blue ring is the filtered gaze."></canvas>
    <svg class="gz-still no-js" viewBox="0 0 540 280" role="img" aria-label="A still frame: raw gaze samples scattered around the middle product, and the filtered gaze resting inside it.">
      {PRODUCTS.map((p, i) => (
        <g>
          <rect x={18 + i * 174} y="62" width="156" height="176" class={i === 1 ? 'on' : ''} />
          <text x={30 + i * 174} y="88">{p.title}</text>
          <rect x={30 + i * 174} y="218" width="132" height="5" class="meter" />
          {i === 1 && <rect x={30 + i * 174} y="218" width="132" height="5" class="meter-on" />}
        </g>
      ))}
      {raw.map(([x, y]) => <circle cx={x} cy={y} r="3" class="raw" />)}
      <path d="M200 205 C 230 180, 250 160, 264 142 S 268 138, 268 139" class="trail" />
      <circle cx="268" cy="139" r="11" class="cur-p" />
      <circle cx="267" cy="138" r="11" class="cur" />
    </svg>
  </div>
  <div class="gz-row">
    <button type="button" class="gz-btn" data-filter aria-pressed="true">One Euro filter: on</button>
    <label class="gz-noise">Noise <input type="range" min="4" max="30" step="1" value="13" data-sigma /> <output data-sigma-out>13 px</output></label>
  </div>
  <dl class="gz-read" aria-live="off">
    <div><dt>Raw jitter</dt><dd data-raw>&#8212;</dd></div>
    <div><dt>After the filter</dt><dd data-filtered>&#8212;</dd></div>
    <div class="gz-focus"><dt>Focus</dt><dd data-focus>{PRODUCTS[1].title}</dd></div>
  </dl>
  <figcaption class="zp-cap">
    A sketch, not Cue&#8217;s tracker: simulated gaze at about 30 samples a second, jitter measured live in the pad&#8217;s own
    pixels.
  </figcaption>
</figure>

<style>
  .gz { margin: 4px 0 0; }
  .gz-pad {
    position: relative; aspect-ratio: 540 / 280; width: 100%;
    border: 2px solid var(--z-blue); border-radius: 3px;
    background: color-mix(in srgb, var(--z-sheet) 88%, var(--z-blue) 4%);
    overflow: hidden;
  }
  .gz-cv { display: block; width: 100%; height: 100%; cursor: crosshair; touch-action: pan-y; }
  .gz-cv:focus-visible { outline: 3px solid var(--z-pink-deep); outline-offset: 2px; }
  :global(html:not(.js)) .gz-cv, :global(html:not(.js)) .gz-row { display: none; }
  .gz-still { display: block; width: 100%; height: 100%; }
  .gz-still rect { fill: none; stroke: var(--z-blue); stroke-width: 2; }
  .gz-still rect.on { fill: var(--z-blue); fill-opacity: .12; stroke-width: 3; }
  .gz-still text { font: 700 15px var(--f-display); fill: var(--z-blue); }
  .gz-still .meter { fill: var(--z-blue); fill-opacity: .18; stroke: none; }
  .gz-still .meter-on { fill: var(--z-pink); stroke: none; }
  .gz-still .raw { fill: var(--z-pink); opacity: .7; }
  .gz-still .trail { fill: none; stroke: var(--z-blue); stroke-width: 2; opacity: .55; }
  .gz-still .cur { fill: none; stroke: var(--z-blue); stroke-width: 2.5; }
  .gz-still .cur-p { fill: none; stroke: var(--z-pink); stroke-width: 2.5; mix-blend-mode: var(--z-plate); }

  .gz-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 12px; }
  .gz-btn {
    cursor: pointer; padding: 7px 11px 6px; border: 2px solid var(--z-blue); border-radius: 4px;
    background: transparent; color: var(--z-ink); font: 700 14px/1 var(--f-display); font-variation-settings: "wdth" 100;
  }
  .gz-btn[aria-pressed="true"] { background: var(--z-blue); color: var(--z-sheet); }
  .gz-noise { display: inline-flex; align-items: center; gap: 8px; font: 650 14px/1 var(--f-display); font-variation-settings: "wdth" 100; }
  .gz-noise input { width: 120px; accent-color: var(--z-pink-deep); }
  .gz-noise output { min-width: 3.4em; font-variant-numeric: tabular-nums; }

  .gz-read { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px 16px; margin: 14px 0 10px; padding-top: 10px; border-top: 1px dashed currentColor; }
  .gz-read div { min-width: 0; }
  .gz-read dt { font: 650 13px/1.2 var(--f-display); font-variation-settings: "wdth" 100; }
  .gz-read dd { margin: 2px 0 0; font: 900 clamp(26px, 7cqw, 38px)/1 var(--f-display); font-variation-settings: "wdth" 64; color: var(--z-blue); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .gz-read [data-raw] { color: var(--z-pink-deep); }
  .gz-read .gz-focus dd { font: 750 16px/1.25 var(--f-display); font-variation-settings: "wdth" 92; white-space: normal; padding-top: 6px; }
  @container (max-width: 380px) {
    .gz-read { grid-template-columns: 1fr 1fr; }
    .gz-read .gz-focus { grid-column: 1 / -1; }
  }
</style>

<script>
  import { initGaze } from './gaze';
  document.querySelectorAll<HTMLElement>('[data-gaze]').forEach(initGaze);
</script>
