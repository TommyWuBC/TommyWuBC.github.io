---
import Base from '../../layouts/Base.astro';
import Opener from '../../components/Opener.astro';
import { getNotes } from '../../lib/content';

const notes = await getNotes();
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Notes" section="Notes" folio="">
  <section class="section" style="padding-bottom: var(--s9)" aria-labelledby="notes-h">
    <Opener folio="" kicker="Writing" id="notes-h">Notes</Opener>
    {notes.length === 0 && <p class="grid"><span style="grid-column: 3 / -1">Nothing here yet.</span></p>}
    {
      notes.map((n) => (
        <article class="entry entry--compact">
          <p class="entry__margin"><span>{fmt(n.data.date)}</span></p>
          <div class="entry__main">
            <h2 class="entry__title"><a href={`/notes/${n.id}/`}>{n.data.title}</a></h2>
            <p class="entry__dek" set:html={n.data.dek} />
          </div>
        </article>
      ))
    }
  </section>
</Base>
