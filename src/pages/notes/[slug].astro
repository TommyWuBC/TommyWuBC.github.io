---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Row from '../../components/article/Row.astro';
import Mark from '../../components/article/Mark.astro';
import Table from '../../components/article/Table.astro';
import { getNotes, plain } from '../../lib/content';

export async function getStaticPaths() {
  return (await getNotes()).map((note) => ({ params: { slug: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const date = note.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base title={note.data.title} description={plain(note.data.dek)} section="Notes" folio="" type="article">
  <article>
    <header class="article-head section">
      <div class="grid">
        <p class="article-head__kicker"><a href="/notes/">Notes</a> / {date}</p>
        <h1 class="article-head__title">{note.data.title}</h1>
        <p class="article-head__dek" set:html={note.data.dek} />
      </div>
    </header>
    <div class="prose section">
      <div class="prose__row"><div class="prose__main"><Content components={{ Row, Mark, Table }} /></div></div>
    </div>
  </article>
</Base>
