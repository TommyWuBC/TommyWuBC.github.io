---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/profile';
import { resolveVideoEmbed } from '../../utils/video';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const videoEmbed = project.video ? resolveVideoEmbed(project.video.url) : null;
---

<BaseLayout title={`${project.title} — Bingchang Wu`} description={project.summary}>
  <Header />
  <main id="main">
    <article class="section project-detail">
      <div class="container project-detail-inner">
        <a class="back-link" href="/#projects">← Back to projects</a>

        <div class="project-image-placeholder" aria-hidden="true">
          <span>{project.title.charAt(0)}</span>
        </div>

        <h1>{project.title}</h1>
        {project.org && <p class="project-meta">{project.org} · {project.dates}</p>}

        <ul class="project-tech" aria-label="Technologies used">
          {project.tech.map((t: string) => (
            <li class="tag">{t}</li>
          ))}
        </ul>

        <div class="project-description">
          {project.description.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </div>

        {project.metrics && project.metrics.length > 0 && (
          <div class="project-metrics">
            <h2>Results</h2>
            <ul>
              {project.metrics.map((m: string) => (
                <li>{m}</li>
              ))}
            </ul>
          </div>
        )}

        {project.video && (
          <div class="project-video">
            <h2>Demo Video</h2>
            {videoEmbed ? (
              videoEmbed.kind === 'file' ? (
                <video class="video-file" controls src={videoEmbed.src}>
                  Your browser doesn't support embedded video.
                  <a href={videoEmbed.src}>Download the video</a> instead.
                </video>
              ) : (
                <div class="video-frame">
                  <iframe
                    src={videoEmbed.src}
                    title={`${project.title} demo video`}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                </div>
              )
            ) : (
              <p class="video-placeholder">
                Demo video coming soon. Once it's recorded, add the YouTube/Vimeo link (or a
                file path like <code>/videos/demo.mp4</code> for a file dropped in{' '}
                <code>public/videos/</code>) to this project's <code>video.url</code> in{' '}
                <code>src/data/profile.ts</code> — it will appear here automatically.
              </p>
            )}
            {project.video.caption && <p class="video-caption">{project.video.caption}</p>}
          </div>
        )}

        {project.userStories && project.userStories.length > 0 && (
          <div class="project-stories">
            <h2>User Story Coverage</h2>
            <ul class="story-list">
              {project.userStories.map((story) => (
                <li class="story-item">
                  <div class="story-head">
                    <span class="story-id">#{story.id}</span>
                    <span class={`tag story-role story-role-${story.role}`}>{story.role}</span>
                  </div>
                  <p class="story-text">{story.story}</p>
                  <p class="story-feature">
                    <strong>How it's addressed:</strong> {story.feature}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {project.process && project.process.length > 0 && (
          <div class="project-process">
            <h2>Process &amp; Approach</h2>
            {project.process.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}

        <div class="project-links">
          {project.links.map((link: { label: string; url: string }) => (
            <a
              class="btn btn-secondary"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .project-detail-inner {
    max-width: 44rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .project-image-placeholder {
    background: linear-gradient(180deg, var(--color-accent-soft), var(--color-bg-alt));
    aspect-ratio: 16 / 7;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    font-size: 3rem;
    font-weight: 700;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }

  .project-meta {
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-4);
  }

  .project-description {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .project-metrics {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .project-metrics h2 {
    font-size: 1rem;
    margin-bottom: var(--space-2);
  }

  .project-metrics ul {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .project-metrics li {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    padding-left: 1rem;
    position: relative;
  }

  .project-metrics li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-video,
  .project-stories,
  .project-process {
    margin-bottom: var(--space-4);
  }

  .project-video h2,
  .project-stories h2,
  .project-process h2 {
    font-size: 1.2rem;
    margin-bottom: var(--space-2);
  }

  .project-process p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-file {
    width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: #000;
  }

  .video-placeholder {
    padding: var(--space-3);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .video-placeholder code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-surface);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .video-caption {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .story-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .story-item {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .story-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }

  .story-id {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .story-role {
    text-transform: capitalize;
  }

  .story-role-admin {
    background: #f5e7d6;
    color: #8a5a15;
  }

  .story-text {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-style: italic;
    margin-bottom: 0.4rem;
  }

  .story-feature {
    font-size: 0.95rem;
    color: var(--color-text);
  }
</style>
