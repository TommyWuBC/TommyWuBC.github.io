---
import Notebook from '../layouts/Notebook.astro';
---

<Notebook title="Not found">
  <div style="max-width:560px;margin:64px auto;padding:48px;background:var(--paper);color:var(--ink);transform:rotate(-1deg);box-shadow:0 20px 40px -20px rgba(0,0,0,.5)">
    <p class="hand" style="font-size:28px;color:var(--pen)">404</p>
    <h1 style="font-size:40px;margin:8px 0 16px">This page was torn out.</h1>
    <p>It may have moved when the site was rebuilt. <a class="pen-link" href="/">Back to the notebook</a>.</p>
  </div>
</Notebook>
