---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" section="Not found" folio="">
  <section class="section" style="padding-bottom: var(--s10)">
    <div class="grid">
      <p style="grid-column: 3 / -1; font-family: var(--sans); font-size: var(--t-small); color: var(--ink-2)">404</p>
      <h1 style="grid-column: 3 / -1; font-weight: 300; font-size: var(--t-h2); line-height: .95; letter-spacing: -.025em; font-variation-settings: 'opsz' 72; max-width: 14ch; margin-top: var(--s4)">
        This page moved the gap.
      </h1>
      <p style="grid-column: 3 / span 6; margin-top: var(--s6)">
        It may have been renamed when the site was rebuilt. The <a href="/">home page</a> has everything, and the
        <a href="/#work">work</a> is a scroll away.
      </p>
    </div>
  </section>
</Base>
