---
// One page per project with an `expansion`. The shell (folder, scroll, zine,
// map) is the scene; the project's MDX body is the content inside it. MDX files
// import their own interactive components, so this route never needs editing
// when a project is added.
import { render } from 'astro:content';
import Notebook from '../../layouts/Notebook.astro';
import FolderShell from '../../components/shells/FolderShell.astro';
import ScrollShell from '../../components/shells/ScrollShell.astro';
import ZineShell from '../../components/shells/ZineShell.astro';
import MapShell from '../../components/shells/MapShell.astro';
import { getProjects, plain } from '../../lib/content';

export async function getStaticPaths() {
  const { expanded } = await getProjects();
  return expanded.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const Shell = { folder: FolderShell, scroll: ScrollShell, zine: ZineShell, map: MapShell }[project.data.expansion!];
---

<Notebook title={project.data.title} description={plain(project.data.dek)} type="article" bodyClass={`shell shell-${project.data.expansion}`}>
  <Shell project={project}>
    <Content />
  </Shell>
</Notebook>
