---
// Every page: <head>, the running head, the page, the colophon.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/schibsted-grotesk/wght.css';
import serifUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/entries.css';
import '../styles/figures.css';
import '../styles/article.css';
import RunningHead from '../components/RunningHead.astro';
import Colophon from '../components/Colophon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Initial text of the running head's section label. */
  section?: string;
  folio?: string;
  /** True on the home page, so nav links are in-page anchors. */
  home?: boolean;
  type?: 'website' | 'article';
}

const { title, description = site.description, section = 'Cover', folio = '1', home = false, type = 'website' } =
  Astro.props;
const pageTitle = title ? `${title}, ${site.name}` : `${site.name}, Georgia Tech`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F2F3EF" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <RunningHead home={home} section={section} folio={folio} />
    <main id="main">
      <slot />
    </main>
    <Colophon />
    <script>
      import '../scripts/running-head';
      import '../scripts/copy';
    </script>
  </body>
</html>
