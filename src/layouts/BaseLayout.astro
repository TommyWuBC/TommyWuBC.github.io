---
import '../styles/global.css';
import { site } from '../data/profile';

interface Props {
  title: string;
  description?: string;
}

const { title, description = `${site.name} | ${site.headline}` } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      // Two independent, purely-additive scroll effects (everything is just
      // visible as normal if JS never runs):
      //  1. Each whole section "pops" in (rise + scale) the first time it's
      //     scrolled into view.
      //  2. Individual headings/paragraphs/list items/cards fade and drift
      //     on their own as they scroll past the header, so the page feels
      //     like a constant, granular fade rather than whole sections
      //     blinking out one at a time.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const sections = Array.from(document.querySelectorAll('main > section, main > article'));

      if (!prefersReduced && sections.length) {
        // --- 1. Section entrance pop -----------------------------------
        sections.forEach((el) => {
          el.setAttribute('data-animate', '');
          const rect = el.getBoundingClientRect();
          if (rect.top > window.innerHeight * 0.85) {
            el.classList.add('is-pending');
          }
        });

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.remove('is-pending');
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        sections.forEach((el) => io.observe(el));

        // --- 2. Per-element fade as content scrolls past the header -----
        // Collect meaningful content units (text and cards), then drop any
        // that are nested inside another match so a card's own heading/
        // paragraph doesn't fade a second time independently of its card.
        const candidates = Array.from(
          document.querySelectorAll(
            [
              'main h1',
              'main h2',
              'main h3',
              'main h4',
              'main p',
              'main li',
              'main .card',
              'main .project-card',
              'main .story-item',
              'main .skill-group',
              'main .hero-text-card',
              'main .hero-actions',
              'main .spotlight-actions',
              'main .spotlight-highlights',
              'main .video-frame',
              'main .video-file',
              'main .video-placeholder',
            ].join(', ')
          )
        );
        const fadeEls = candidates.filter(
          (el) => !candidates.some((other) => other !== el && other.contains(el))
        );
        fadeEls.forEach((el) => el.classList.add('scroll-fade'));

        const header = document.querySelector('.site-header');
        const headerOffset = header ? header.getBoundingClientRect().height : 0;
        const FADE_ZONE = 150;

        let ticking = false;

        function updateFades() {
          fadeEls.forEach((el) => {
            if (el.closest('[data-animate].is-pending')) return;
            const rect = el.getBoundingClientRect();
            const bottom = rect.bottom - headerOffset;
            let opacity = 1;
            if (bottom < FADE_ZONE) {
              opacity = Math.max(0, bottom / FADE_ZONE);
            }
            el.style.opacity = String(opacity);
            el.style.transform =
              opacity < 1
                ? `translateY(-${(1 - opacity) * 26}px) scale(${1 - (1 - opacity) * 0.03})`
                : '';
          });
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(updateFades);
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        updateFades();
      }
    </script>
  </body>
</html>
